      "css": ".ds-btn-go{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:36px;padding:6px 14px;border-radius:var(--radius,2px);font-family:var(--font,\"Atkinson Hyperlegible Next\",system-ui,sans-serif);font-size:14px;font-weight:700;white-space:nowrap;cursor:pointer;background:var(--brick,#c4432b);border:1px solid var(--brick,#c4432b);color:#fff;}.ds-btn-go:hover{background:var(--brick-ink,#b03a24);border-color:var(--brick-ink,#b03a24);}.ds-btn-go:focus-visible{outline:2px solid var(--brick,#c4432b);outline-offset:2px;}"
    },
    {
      "name": "Going Button",
      "kind": "button",
      "refersTo": "button-going",
      "description": "The committed state: brick wash, brick border, check.",
      "html": "<button class=\"ds-btn-going\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"square\"/></svg>Going</button>",
      "css": ".ds-btn-going{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:36px;padding:6px 14px;border-radius:var(--radius,2px);font-family:var(--font,\"Atkinson Hyperlegible Next\",system-ui,sans-serif);font-size:14px;font-weight:700;white-space:nowrap;cursor:pointer;background:var(--brick-wash,#f7e3dd);border:1px solid var(--brick,#c4432b);color:var(--brick-ink,#b03a24);}.ds-btn-going:hover{border-color:var(--brick-ink,#b03a24);}.ds-btn-going:focus-visible{outline:2px solid var(--brick,#c4432b);outline-offset:2px;}"
    },
    {
      "name": "Slate Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Default button: slate fill, square; inverts to a light fill in dark.",
      "html": "<button class=\"ds-btn\">Apply</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:36px;padding:6px 14px;border-radius:var(--radius,2px);font-family:var(--font,\"Atkinson Hyperlegible Next\",system-ui,sans-serif);font-size:14px;font-weight:700;white-space:nowrap;cursor:pointer;background:var(--action,#23262b);border:1px solid var(--action,#23262b);color:var(--on-action,#fff);}.ds-btn:hover{background:var(--action-hover,#000);border-color:var(--action-hover,#000);}.ds-btn:focus-visible{outline:2px solid var(--brick,#c4432b);outline-offset:2px;}"
    },
    {
      "name": "Quiet Button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Outlined button for long lists, so rows are not a column of filled buttons.",
      "html": "<button class=\"ds-btn-quiet\">I'm going</button>",
      "css": ".ds-btn-quiet{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:36px;padding:6px 14px;border-radius:var(--radius,2px);font-family:var(--font,\"Atkinson Hyperlegible Next\",system-ui,sans-serif);font-size:14px;font-weight:700;white-space:nowrap;cursor:pointer;background:transparent;border:1px solid var(--field-line,#a9a7a0);color:var(--text,#1b1e22);}.ds-btn-quiet:hover{border-color:var(--ink,#1b1e22);}.ds-btn-quiet:focus-visible{outline:2px solid var(--brick,#c4432b);outline-offset:2px;}"
    },
    {
      "name": "Filter Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Square filter chip with an optional category dot; selected fills slate.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip ds-chip-on\">All</button><button class=\"ds-chip\"><i class=\"ds-dot\" style=\"background:#881070\"></i>Cultural</button><button class=\"ds-chip\"><i class=\"ds-dot\" style=\"background:#2785f7\"></i>Tech &amp; Engineering</button></div>",
      "css": ".ds-chips{display:flex;gap:6px;flex-wrap:wrap;}.ds-chip{display:inline-flex;align-items:center;gap:6px;padding:6px 11px;border:1px solid var(--line,#d4d2cb);border-radius:var(--radius,2px);background:var(--surface,#fff);color:var(--text,#1b1e22);font-family:var(--font,\"Atkinson Hyperlegible Next\",system-ui,sans-serif);font-size:14px;font-weight:500;cursor:pointer;}.ds-chip:hover{border-color:var(--field-line,#a9a7a0);}.ds-chip-on{background:var(--action,#23262b);border-color:var(--action,#23262b);color:var(--on-action,#fff);font-weight:700;}.ds-chip:focus-visible{outline:2px solid var(--brick,#c4432b);outline-offset:2px;}.ds-dot{width:8px;height:8px;border-radius:50%;display:inline-block;}"
    },
    {
      "name": "Building-Code Plate",
      "kind": "custom",
      "refersTo": "plate",
      "description": "Signature: a building code as on a campus sign, room number lighter; brick when the event is on now. Only for codes placeCode() derives.",
      "html": "<span class=\"ds-plate\">MGH<span class=\"ds-plate-room\">241</span></span> <span class=\"ds-plate ds-plate-now\">HUB<span class=\"ds-plate-room\">145</span></span>",
      "css": ".ds-plate{display:inline-flex;align-items:baseline;gap:5px;padding:3px 7px 2px;background:var(--slate,#23262b);color:var(--on-slate,#fff);font-family:var(--font,\"Atkinson Hyperlegible Next\",system-ui,sans-serif);font-size:12px;font-weight:700;line-height:1.3;letter-spacing:0.02em;font-variant-numeric:tabular-nums;border-radius:var(--radius,2px);white-space:nowrap;}.ds-plate-room{font-weight:400;color:var(--on-slate-muted,#b3b8bf);}.ds-plate-now{background:var(--brick,#c4432b);color:#fff;}"
    },
    {
      "name": "Starts Tag",
      "kind": "chip",
      "refersTo": "starts-now",
      "description": "Brick time-to-start; Now is a filled brick tag.",
      "html": "<span class=\"ds-starts\">In 12 min</span> <span class=\"ds-starts ds-starts-now\">Now</span>",
      "css": ".ds-starts{display:inline-block;font-family:var(--font,\"Atkinson Hyperlegible Next\",system-ui,sans-serif);font-size:11px;font-weight:700;letter-spacing:0.02em;font-variant-numeric:tabular-nums;color:var(--brick-ink,#b03a24);white-space:nowrap;}.ds-starts-now{padding:1px 6px;background:var(--brick,#c4432b);color:#fff;border-radius:var(--radius,2px);}"
    },
    {
      "name": "Next Up Sign",
      "kind": "card",
      "refersTo": "sign-panel",
      "description": "A slate sign panel floating on the map: sign header, ruled rows of plate, title over place, time.",
      "html": "<section class=\"ds-sign\"><h2 class=\"ds-sign-h\">Next up</h2><ol class=\"ds-sign-list\"><li><button class=\"ds-sign-row\"><span class=\"ds-p\">MGH</span><span class=\"ds-t\"><strong>Chess Club weekly</strong><span>Mary Gates Hall 241</span></span><span class=\"ds-time\">4:30 PM<span class=\"ds-soon\">In 12 min</span></span></button></li><li><button class=\"ds-sign-row\"><span class=\"ds-p\">HUB</span><span class=\"ds-t\"><strong>Study night</strong><span>HUB 145</span></span><span class=\"ds-time\">6:00 PM</span></button></li></ol></section>",
      "css": ".ds-sign{width:360px;max-width:100%;padding:14px 0 6px;background:var(--panel,#23262b);color:var(--on-slate,#fff);border:1px solid var(--nav-line,#23262b);border-radius:var(--radius,2px);box-shadow:var(--shadow,0 1px 2px rgba(15,17,20,.18),0 8px 24px rgba(15,17,20,.16));font-family:var(--font,\"Atkinson Hyperlegible Next\",system-ui,sans-serif);}.ds-sign-h{margin:0;padding:0 14px 10px;border-bottom:1px solid var(--slate-line,#3e434a);font-size:13px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--on-slate-muted,#b3b8bf);}.ds-sign-list{list-style:none;margin:0;padding:0;}.ds-sign-list li+li{border-top:1px solid var(--slate-line,#3e434a);}.ds-sign-row{display:grid;grid-template-columns:80px minmax(0,1fr) auto;gap:10px;width:100%;padding:10px 14px;background:none;border:none;color:inherit;font:inherit;text-align:left;cursor:pointer;}.ds-sign-row:hover{background:var(--slate-2,#33373d);}.ds-sign-row:focus-visible{outline:2px solid var(--brick,#c4432b);outline-offset:-2px;}.ds-p{justify-self:start;padding:3px 7px 2px;background:#fff;color:#15171a;font-size:12px;font-weight:700;letter-spacing:.02em;border-radius:2px;}.ds-t{display:flex;flex-direction:column;min-width:0;}.ds-t strong{font-size:15px;line-height:1.25;}.ds-t span{font-size:13px;color:var(--on-slate-muted,#b3b8bf);}.ds-time{display:flex;flex-direction:column;align-items:flex-end;gap:2px;font-size:13px;font-weight:700;font-variant-numeric:tabular-nums;}.ds-soon{font-size:11px;color:#ff9479;}"
    },
    {
      "name": "Sign Bar",
      "kind": "nav",
      "refersTo": "sign-bar",
      "description": "56px slate top bar: wordmark with brick square, tabs, brick underline on the active tab.",
      "html": "<nav class=\"ds-nav\"><span class=\"ds-logo\"><i class=\"ds-mark\"></i>DubHub</span><div class=\"ds-tabs\"><button class=\"ds-tab ds-tab-on\">Home</button><button class=\"ds-tab\">Events</button><button class=\"ds-tab\">My Events</button><button class=\"ds-tab\">Clubs</button></div><button class=\"ds-signin\">Sign in</button></nav>",
      "css": ".ds-nav{display:flex;align-items:stretch;gap:28px;height:56px;padding:0 20px;background:var(--nav-bg,#23262b);color:var(--on-slate,#fff);font-family:var(--font,\"Atkinson Hyperlegible Next\",system-ui,sans-serif);}.ds-logo{display:flex;align-items:center;gap:10px;font-size:20px;font-weight:800;letter-spacing:-.01em;}.ds-mark{width:12px;height:12px;background:var(--brick,#c4432b);}.ds-tabs{display:flex;gap:2px;flex:1;}.ds-tab{position:relative;background:none;border:none;color:var(--on-slate-muted,#b3b8bf);font:inherit;font-size:15px;font-weight:500;padding:0 12px;cursor:pointer;}.ds-tab:hover{color:var(--on-slate,#fff);}.ds-tab-on{color:var(--on-slate,#fff);font-weight:700;}.ds-tab-on::after{content:\"\";position:absolute;left:12px;right:12px;bottom:0;height:3px;background:var(--brick,#c4432b);}.ds-tab:focus-visible{outline:2px solid var(--brick,#c4432b);outline-offset:-4px;}.ds-signin{align-self:center;background:#fff;color:#23262b;border:none;font:inherit;font-size:14px;font-weight:700;padding:8px 14px;border-radius:2px;cursor:pointer;}.ds-signin:hover{background:#e4e3de;}"
    }
  ],
  "narrative": {
    "northStar": "The Campus Sign",
    "overview": "DubHub is campus wayfinding for what's on. The visual world comes from UW's own signage: dark slate sign panels with white type, the concrete and brick of Red Square underfoot, and building codes like \"MGH 241\" set as small plates. The full-bleed campus map is the home screen, and anything that floats over it is drawn as a sign: slate, square, edged in 1px, set in one humanist sans.\n\nThe density is built for a phone between classes. A ruled white sheet holds the lists, slate day bands divide them, and every row reads left to right as time, plate, title, action. Color is rare on purpose. The chrome is slate and concrete. Scraped event photos, club avatars, and the category dots on the map supply the color. Brick appears only where something is happening now or where the student has committed to it.\n\nThe world was chosen to replace a generic event-app look. Its confirmed rejections: purple pill chips, rounded cards floating on shadows, a filled \"Join\" button on every row, and a centered hero box.",
    "keyCharacteristics": [
      "Slate sign panels (top bar, map panels, day bands, plates) over a concrete ground.",
      "Red Square brick is the only accent, and it always means now, soon, active, or going.",
      "Building-code plates are the signature, drawn only where a real code exists.",
      "One typeface (Atkinson Hyperlegible Next) for every word, with tabular figures for times and codes.",
      "2px corners, 1px rules, and one shadow, used only for things floating over the map.",
      "Light and dark themes only."
    ],
    "rules": [
      {
        "name": "The One Brick Rule",
        "body": "Brick means only four things: on now or starting soon, the active tab, the event \"I'm going\" action, and \"going\". Every other button is slate, outlined, or a white sheet. If an element isn't one of those four, it is not brick.",
        "section": "colors"
      },
      {
        "name": "The Plum Not Red Rule",
        "body": "No category color may sit near brick's hue. Cultural moved to plum so that a dot is never mistaken for \"starting soon\". Any new or changed category color is re-run through the all-pairs validator on both map grounds.",
        "section": "colors"
      },
      {
        "name": "The Content Is The Color Rule",
        "body": "The chrome stays slate, concrete, and white. Photos, avatars, and map dots carry the color.",
        "section": "colors"
      },
      {
        "name": "The One Face Rule",
        "body": "Every word, time, and code is set in Atkinson Hyperlegible Next. The Mono cut was tried and dropped because its slab letters read as a typewriter costume, while campus signs set codes in the same humanist sans. Alignment comes from tabular figures, not from a second family.",
        "section": "typography"
      },
      {
        "name": "The Only Things That Float Rule",
        "body": "A shadow means \"this is floating over the map\". Use the one shadow token for that and nothing else. Page content never casts a shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep brick to its four meanings: now or soon, the active tab, the \"I'm going\" action, and going.",
      "Do draw a plate only from a code placeCode() actually derives, and let the title take the space when there isn't one.",
      "Do set times and codes in Atkinson Hyperlegible Next with tabular figures.",
      "Do use 2px corners and 1px rules everywhere, and the single float shadow only for things over the map.",
      "Do invert plates to the light plate on dark grounds so they still read as plates.",
      "Do re-validate the category palette for all pairs on both map grounds whenever a category color changes, and keep it off brick's hue.",
      "Do ship every surface in light and dark, following the device unless the user picks one."
    ],
    "donts": [
      "Don't make a filled \"Join\" button on every row. Use the quiet outlined button in lists.",
      "Don't use purple pill chips, rounded floating cards, or a centered hero box.",
      "Don't invent building codes or decorative plates for places that don't have one.",
      "Don't add a second typeface, including the Atkinson Mono cut.",
      "Don't put a shadow on page content, or use any shadow value besides the float token.",
      "Don't use category colors as chrome (buttons, panels, headings).",
      "Don't add themes beyond light and dark.",
      "Don't add invented small labels above titles. The only uppercase lines are sign-panel headers and the callout's category legend."
    ]
  }
}
